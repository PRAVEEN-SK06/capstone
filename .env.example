# Copy this file to .env and fill in your own values. Never commit .env.

# Required for answer generation and for the Gemini embedding model /
# conversational "condense question" step. Get a free key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: only needed on this machine because the C: drive is nearly full.
# Redirects the HuggingFace model cache (used for local embeddings and the
# cross-encoder reranker) to a drive with more free space. Remove this line
# if you deploy on a machine/container with a normal amount of disk space.
HF_HOME=D:/pm_env_support/hf-cache
